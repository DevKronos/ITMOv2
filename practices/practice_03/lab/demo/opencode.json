{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5:3b-instruct",
  "small_model": "ollama/qwen2.5:3b-instruct",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "qwen2.5:3b-instruct": {
          "name": "Qwen 2.5 3B Instruct (Ollama)"
        },
        "local-practice03": {
          "name": "Practice 03 Qwen 2.5 3B"
        }
      }
    }
  },
  "agent": {
    "qwen-local": {
      "description": "Qwen 2.5 3B via Ollama (WSL2 CPU-only)",
      "mode": "primary",
      "model": "ollama/qwen2.5:3b-instruct",
      "steps": 8,
      "permission": {
        "*": "ask",
        "edit": "deny"
      }
    },
    "Practice-3.Local": {
      "description": "Local Qwen model for practice 03",
      "mode": "primary",
      "model": "ollama/local-practice03",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    },
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}