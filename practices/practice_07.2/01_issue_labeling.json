    {
      "parameters": {
        "jsCode": "let value=$input.first().json.text ?? $input.first().json.output ?? '';\nif (typeof value === 'object') value=JSON.stringify(value);\nconst raw=String(value).replace(/^```(?:json)?\\s*/i,'').replace(/\\s*```$/,'').trim();\nlet parsed={};try{parsed=JSON.parse(raw)}catch(e){}\nif (typeof $input.first().json.output === 'object' && $input.first().json.output !== null) parsed=$input.first().json.output;\nlet type=String(parsed.type??'unknown').toLowerCase();\nif(!['bug','task','feature'].includes(type))type='unknown';\nlet confidence=Number(parsed.confidence);\nif(!Number.isFinite(confidence)||confidence<0||confidence>1)confidence=0;\nreturn [{json:{type,confidence}}];"
      },
      "id": "db7ab4d1-2221-43da-8c4b-0112179f7107",
