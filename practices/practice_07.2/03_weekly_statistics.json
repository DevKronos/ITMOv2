    {
      "parameters": {
        "jsCode": "const now=new Date();\n// Set to YYYY-MM-DD for a simulated week (Monday), leave empty normally:\nconst OVERRIDE_WEEK_START='';\nconst day=(now.getUTCDay()+6)%7;\nconst monday=new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate()-day));\nconst start=OVERRIDE_WEEK_START?new Date(OVERRIDE_WEEK_START+'T00:00:00Z'):new Date(monday.getTime()-7*86400000);\nconst end=new Date(start.getTime()+7*86400000);\nconst iso=x=>x.toISOString().slice(0,10);\nreturn [{json:{owner:'DevKronos',repo:'TestRepo',week_start:iso(start),week_end:iso(end),previous_week_start:iso(new Date(start.getTime()-7*86400000)),query_end:iso(new Date(end.getTime()-86400000))}}];"
      },
