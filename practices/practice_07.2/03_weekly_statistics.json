    {
      "parameters": {
        "jsCode": "const types=['bug','task','feature','needs-triage'];\nconst nodes=['Find bug Issues','Find task Issues','Find feature Issues','Find needs-triage Issues'];\nconst unique=new Map();const by_type={};const by_author={};const truncated=[];\nfor(let i=0;i<4;i++){\n const response=$(nodes[i]).first().json;\n const items=Array.isArray(response.items)?response.items:[];\n by_type[types[i]]=items.length;\n if((response.total_count||0)>items.length)truncated.push(types[i]);\n for(const issue of items){\n   const key=String(issue.id??issue.number);\n   if(!unique.has(key))unique.set(key,issue);\n }\n}\nfor(const issue of unique.values()){\n const author=issue.user?.login??'unknown';\n by_author[author]=(by_author[author]??0)+1;\n}\nconst week=$('Week boundaries and repository').first().json;\nreturn [{json:{...week,counts:by_type,authors:by_author,total:unique.size,truncated}}];"
      },
