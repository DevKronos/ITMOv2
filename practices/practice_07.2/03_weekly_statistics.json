      "parameters": {
        "jsCode": "const current=$('Aggregate by type and author').first().json;\nconst prev=$input.first().json;\nlet previous={};try{previous=JSON.parse(prev.counts_json||'{}')}catch(e){}\nconst delta={};for(const t of ['bug','task','feature','needs-triage'])delta[t]=prev.week_start?((current.counts[t]||0)-(previous[t]||0)):null;\nconst totalDelta=prev.week_start?current.total-Number(prev.total||0):null;\nreturn [{json:{...current,delta,total_delta:totalDelta,has_previous:Boolean(prev.week_start)}}];"
      },
