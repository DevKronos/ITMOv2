    {
      "parameters": {
        "jsCode": "const d=$('Restore report context').first().json;\nconst comment=String($input.first().json.text??$input.first().json.output??'').trim();\nconst esc=x=>String(x??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/\"/g,'&quot;').replace(/'/g,'&#39;');\nconst cell=x=>x===null?'нет данных':x>0?'+'+x:String(x);\nlet typeRows='';for(const [t,count] of Object.entries(d.counts))typeRows+=`<tr><td>${esc(t)}</td><td>${count}</td><td>${esc(cell(d.delta[t]))}</td></tr>`;\nlet authorRows='';for(const [author,count] of Object.entries(d.authors).sort((a,b)=>b[1]-a[1]))authorRows+=`<tr><td>${esc(author)}</td><td>${count}</td></tr>`;\nconst warning=d.truncated.length?'<p><strong>Внимание:</strong> GitHub вернул больше 100 результатов для: '+esc(d.truncated.join(', '))+'. Данные неполные.</p>':'';\nconst html=`<h2>GitHub Issues: ${esc(d.week_start)} — ${esc(d.week_end)} (конец не включительно)</h2><p>Всего уникальных Issues: <strong>${d.total}</strong>; изменение: ${esc(cell(d.total_delta))}</p><h3>По типам</h3><table border=\"1\" cellpadding=\"7\" cellspacing=\"0\"><tr><th>Тип</th><th>Количество</th><th>Δ</th></tr>${typeRows}</table><h3>По авторам</h3><table border=\"1\" cellpadding=\"7\" cellspacing=\"0\"><tr><th>Автор</th><th>Количество</th></tr>${authorRows}</table><h3>AI-комментарий недели</h3><p>${esc(comment)}</p>${warning}`;\nreturn [{json:{html,subject:'GitHub Issues — '+d.week_start+' — '+d.week_end,total:d.total}}];"
      },
